---
/**
 * A command or prompt the reader is meant to run. Copy button included, because
 * a command you have to select by hand is a command people get wrong.
 */
import CopyButton from './CopyButton.astro';

interface Props {
  label?: string;
  /** The exact text copied to the clipboard. */
  code: string;
  /** "shell" sets the block in mono at a smaller size; "prompt" wraps prose. */
  variant?: 'shell' | 'prompt';
}
const { label, code, variant = 'shell' } = Astro.props;
const text = code.trim();
---

<figure class={`copy-block ${variant}`}>
  {label && <figcaption class="label">{label}</figcaption>}
  <div class="body">
    <pre><code>{text}</code></pre>
    <CopyButton code={text} class="in-block" />
  </div>
</figure>

<style>
  .copy-block {
    margin: var(--space-5) 0;
  }

  .copy-block .label {
    display: block;
    margin-bottom: var(--space-2);
  }

  .body {
    position: relative;
    background: var(--ink-raised);
    border: var(--hairline) solid var(--ink-line);
    border-radius: var(--radius);
  }

  pre {
    margin: 0;
    padding: var(--space-4);
    padding-right: 6rem;
    font-family: var(--font-mono);
    font-size: var(--size-sm);
    line-height: 1.6;
    color: var(--bone);
    /* Wrap rather than scroll. What matters is that the copy is exact, and a
       long one-liner behind a scrollbar is a command people get wrong. */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .prompt pre {
    white-space: pre-wrap;
    word-break: break-word;
    font-family: var(--font-body);
    font-size: var(--size-sm);
    color: var(--bone);
  }

  :global(.copy.in-block) {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
  }
</style>
