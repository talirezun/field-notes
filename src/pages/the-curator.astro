---
import Base from '../layouts/Base.astro';
import RuleLabel from '../components/RuleLabel.astro';
import CopyBlock from '../components/CopyBlock.astro';
import Downloads from '../components/Downloads.astro';
import { LINKS, SITE_URL, AUTHOR, isoDate } from '../lib/site';

const updated = new Date('2026-08-20T00:00:00Z');
const path = '/the-curator';

const description =
  'Your brain, your team\'s brain, your agents\' brain. The Curator keeps all three as plain markdown on your own machine, readable by any agent that speaks MCP. Here is how to install it and ingest this corpus.';

const agentPrompt = `Install The Curator on this machine.

Repo: ${LINKS.curatorRepo}

Do this:
1. Clone the repo into a sensible directory and read its README before running anything.
2. Check I have Node 18 or newer. Tell me if I do not, and stop.
3. Install dependencies and start the server.
4. Tell me the local URL to open, and what the onboarding wizard will ask me for.

Do not add an API key yourself. Tell me where to paste mine and stop there.`;

const queries = [
  {
    label: 'Trace a claim to its sources',
    text: 'Across the Field Notes corpus, what does the author say fails most often in phase two of a build, and which sources back that up? Quote the specific passages and name the chapter each one came from.',
  },
  {
    label: 'Find the disagreements',
    text: 'Read the whole Field Notes corpus and find places where the author contradicts himself, or where a later chapter revises a position taken in an earlier one. List each one with both passages.',
  },
  {
    label: 'Apply it to your own situation',
    text: 'Using only the Field Notes corpus, draft the first ninety days of an AI adoption plan for a 300-person European manufacturer with no in-house ML team. Flag every point where the corpus does not actually cover the question, rather than filling the gap yourself.',
  },
  {
    label: 'Pressure-test it',
    text: 'Take the strongest claim in the Field Notes corpus about agent memory and argue against it. Use only evidence from the corpus itself, and say clearly where the corpus gives you nothing to argue with.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Ingest the Field Notes corpus into The Curator',
  description,
  url: `${SITE_URL}${path}`,
  dateModified: isoDate(updated),
  author: {
    '@type': 'Person',
    name: AUTHOR.name,
    jobTitle: AUTHOR.jobTitle,
    affiliation: { '@type': 'Organization', name: AUTHOR.affiliation },
    url: AUTHOR.homepage,
    sameAs: [...AUTHOR.sameAs],
  },
  step: [
    { '@type': 'HowToStep', name: 'Install The Curator', url: `${SITE_URL}${path}#install` },
    { '@type': 'HowToStep', name: 'Add an API key', url: `${SITE_URL}${path}#ingest` },
    { '@type': 'HowToStep', name: 'Create a domain', url: `${SITE_URL}${path}#ingest` },
    { '@type': 'HowToStep', name: 'Download and unzip the corpus', url: `${SITE_URL}${path}#ingest` },
    { '@type': 'HowToStep', name: 'Drop each file into the Ingest tab', url: `${SITE_URL}${path}#ingest` },
    { '@type': 'HowToStep', name: 'Query it', url: `${SITE_URL}${path}#query` },
  ],
};
---

<Base title="The Curator" description={description} path={path} updated={updated} schema={schema}>
  <div class="shell page">
    <header class="head measure">
      <p class="label">The tool behind the corpus</p>
      <h1>The Curator</h1>
      <p class="lede">
        Your brain, your team's brain, your agents' brain. Three layers of context, kept
        as plain markdown on your own machine.
      </p>
      <p class="meta">
        <a href={LINKS.curatorSite} target="_blank" rel="noopener">mycurator.xyz</a> ·
        MIT, mostly · <a href={LINKS.curatorRepo} target="_blank" rel="noopener">
          github.com/talirezun/the-curator
        </a>
      </p>
      <p class="badge">
        <a href={LINKS.curatorRepo} target="_blank" rel="noopener">
          <img
            src="https://img.shields.io/github/stars/talirezun/the-curator?style=flat-square&label=stars&color=A89372&labelColor=1A1713"
            alt="GitHub stars for talirezun/the-curator"
            height="20"
            loading="lazy"
          />
        </a>
      </p>
    </header>

    <section class="measure stack-4" aria-labelledby="what">
      <RuleLabel as="h2" label="What it is" id="what" />
      <p>
        The Curator is where your context lives, and it holds three different kinds of it.
        The name for that is the whole product in five words: your brain, your team's
        brain, your agents' brain.
      </p>

      <ol class="layers">
        <li>
          <p class="label">One. Your brain</p>
          <p>
            A personal wiki, one per domain. You drop in a PDF, an article or a note, and
            it reads the source and writes interlinked pages: the entities, the concepts,
            and a summary. Every later source makes the existing pages richer instead of
            landing beside them as a duplicate. Knowledge <strong>accumulates</strong>.
          </p>
        </li>
        <li>
          <p class="label">Two. Your team's brain</p>
          <p>
            The same thing built collectively. A cohort or a team each keep their own
            private graph and opt specific domains into a shared one, attributed, without
            anyone handing over the rest of their notes. Opt in, never on by default.
          </p>
        </li>
        <li>
          <p class="label">Three. Your agents' brain</p>
          <p>
            Working state: where the build actually stands, what is settled, what was
            tried and ruled out. Your agent writes it at the end of a session and reads it
            at the start of the next one. State <strong>supersedes</strong>, so each save
            replaces the last rather than merging into it, because a blocker you cleared
            on Tuesday must not come back on Wednesday.
          </p>
        </li>
      </ol>

      <p>
        That last distinction is the design, not a detail. A wiki that overwrote itself
        would lose everything you have learned. A handoff that accumulated would hand the
        next session a pile of stale blockers with no way to say which ones are still
        true.
      </p>

      <p>
        All of it is plain markdown in a folder you chose. Any editor opens it, Obsidian
        draws the graph, and your own private GitHub repo syncs it. There is no database,
        no proprietary format, and no service of mine anywhere in the picture.
      </p>

      <p class="caveat">
        <strong>Be clear about the dependency.</strong> It needs an API key from Google
        Gemini, Anthropic or OpenRouter, because reading a source and writing wiki pages
        is model work. There is no version of this that runs on nothing. Gemini has a free
        tier that covers trying it out, and the honest figure for heavy solo use on the
        default model is around five euros a month. Anthropic is roughly ten times that
        for the same workload. Reading pages, syncing, and the MCP bridge itself cost
        nothing at all.
      </p>
    </section>

    <section class="measure stack-4" aria-labelledby="neutral">
      <RuleLabel as="h2" label="Nothing here is locked to anyone" id="neutral" />
      <p>
        Claude Projects, ChatGPT Projects and Cursor rules each hold your accumulated
        context inside one company's product. You leave it behind on the day you switch
        tools, or switch models, or switch machines. That is the problem this is built
        against, and the answer is structural rather than clever: there is no proprietary
        store to leave behind in the first place.
      </p>
      <p>
        The files are markdown in a folder you picked. The sync target is your own private
        GitHub repository, not a service I run. The bridge is MCP, which is a protocol
        rather than an integration, so any local MCP client speaks it: Claude Desktop,
        Claude Code, Cursor, or something you wrote yourself. The models are swappable
        between Gemini, Anthropic and OpenRouter. A second brain you can only open through
        one vendor's client is not a second brain, it is that vendor's product with your
        notes in it.
      </p>
      <p>
        The part I care about most is that working state crosses the same boundaries. A
        handoff written by an orchestrator in one harness is readable by an agent in
        another, on a different model, on a different machine, the next morning.
      </p>
    </section>

    <section class="measure stack-4" aria-labelledby="site">
      <RuleLabel as="h2" label="Ask the site instead of reading it" id="site" />
      <p>
        The product has a home of its own at
        <a href={LINKS.curatorSite} target="_blank" rel="noopener">mycurator.xyz</a>, and
        the fastest way to find out whether it fits you is to ask it. The page runs on
        <a href="/what-i-shipped#lumina">Lumina</a>, grounded in the product documentation,
        so you can ask how to install it, what it costs, whether it runs on Windows, or how
        the working state layer behaves, and get an answer that links into the section of
        the page that covers it. Most of what is on this page is answerable there in a
        sentence.
      </p>
      <p class="note">
        The site itself is plain static files on the edge with the conversation woven into
        the page rather than parked in a corner. I wrote the build up as a manual, because
        that shape is the one I now think every product website should have. It is cited
        from <a href="/what-i-shipped#lumina">chapter nine</a>.
      </p>
    </section>

    <section class="measure stack-4" aria-labelledby="why">
      <RuleLabel as="h2" label="Why it is on this site" id="why" />
      <p>
        The corpus you are reading was built and is maintained in it. Every chapter here
        started as notes in that graph and was edited down by hand.
      </p>
      <p>
        So ingesting this corpus is two things at once. It gives you a queryable version of
        everything I have worked out, and it is a genuine first run of the tool on real
        material rather than on a demo file. That is a better demonstration than anything I
        could write about it.
      </p>
    </section>

    <section class="measure stack-4" aria-labelledby="install">
      <RuleLabel as="h2" label="Install" id="install" />
      <p>
        The friendlier version of this, with the download and the Windows and Linux setup
        side by side, is the Quick start on
        <a href={LINKS.curatorSite} target="_blank" rel="noopener">mycurator.xyz</a>. The
        commands are the same. On macOS, one line:
      </p>
      <CopyBlock
        label="macOS"
        code="curl -fsSL https://raw.githubusercontent.com/talirezun/the-curator/main/install.sh | bash"
      />
      <p class="note">
        That script is readable at the URL above. Read it before you run it, the same as
        you would with anyone else's install script.
      </p>
      <p>
        On Windows and Linux it is a manual setup, and the Node server runs anywhere Node
        18 or newer runs. Only the one-line installer and the Dock app are macOS specific.
        Clone the repo,
        <code>npm install</code>, <code>node src/server.js</code>, then open
        <code>localhost:3333</code>. The canonical steps are in the repo:
      </p>
      <p>
        <a class="out" href={LINKS.curatorManualSetup} target="_blank" rel="noopener">
          Manual setup for Windows, Linux and Mac
        </a>
      </p>
    </section>

    <section class="measure stack-4" aria-labelledby="agent-install">
      <RuleLabel as="h2" label="Install it with a coding agent" id="agent-install" />
      <p>
        If you already have Claude Code, Cursor, OpenCode, Augment or Cline running, hand
        it this and let it do the work. The canonical version of this prompt lives in the
        User Guide in the repo, and it is mirrored here so you do not have to leave the
        page.
      </p>
      <CopyBlock label="Paste into your coding agent" variant="prompt" code={agentPrompt} />
      <p>
        <a class="out" href={LINKS.curatorAgentInstall} target="_blank" rel="noopener">
          User Guide §20, the canonical agent install prompt
        </a>
      </p>
    </section>

    <section class="stack-4" aria-labelledby="ingest">
      <RuleLabel as="h2" label="Ingest this corpus" id="ingest" />
      <div class="measure stack-4">
        <p>
          The Curator builds a wiki from source documents, so what you are handing it is
          the markdown, not a pre-built graph. Ten files, a few minutes, and the tool does
          the rest. That is the accurate description and it is also the better demo.
        </p>
        <ol class="steps">
          <li>Install it, using either route above.</li>
          <li>Add your Gemini or Anthropic API key in the onboarding wizard.</li>
          <li>Create a domain. The ⚙️ Tech/AI template fits this corpus.</li>
          <li>Download the chapters zip below and unzip it.</li>
          <li>Drop each <code>.md</code> file into the Ingest tab.</li>
          <li>
            Open the Chat tab, or connect the My Curator MCP bridge from Settings and point
            whichever agent you already use at it.
          </li>
        </ol>
        <p class="caveat">
          Cost, honestly: ingesting ten chapters is a small number of model calls. It sits
          comfortably inside Gemini's free tier as a one-off, and it is cents on a paid
          key.
        </p>
      </div>
      <Downloads heading="The corpus" />
    </section>

    <section class="measure stack-4" aria-labelledby="query">
      <RuleLabel as="h2" label="Then ask it something" id="query" />
      <p>
        Once the MCP bridge is connected, these go straight into whatever you have
        connected it to. They are written to be worth running rather than to look
        impressive.
      </p>
      {queries.map((query) => <CopyBlock label={query.label} variant="prompt" code={query.text} />)}
    </section>

    <section class="measure stack-4" aria-labelledby="limits">
      <RuleLabel as="h2" label="What it does not do" id="limits" />
      <p>
        A tool that overclaims about memory is worse than no tool, so here is the list I
        would want to read before installing something.
      </p>
      <ul class="limits">
        <li>
          <strong>Capture is advisory.</strong> Nothing forces an agent to save at the end
          of a session. Miss one and the next read returns the previous state: stale, never
          corrupted, and nothing that was saved is lost. Failing in that direction is why
          there is no enforcement.
        </li>
        <li>
          <strong>Reading is portable, saving is not, quite.</strong> Any MCP client can
          read your state, because that half is pure protocol. What an agent in another
          harness lacks is anything telling it to save. The instruction is ordinary prose
          that works wherever you paste it, but switching itself on automatically is a
          Claude mechanism today.
        </li>
        <li>
          <strong>It needs a local MCP client.</strong> The bridge is a child process on
          your machine, so anything that can spawn a local program works and a browser-only
          assistant cannot reach it at all. That is a consequence of the design, not a gap
          in it.
        </li>
        <li>
          <strong>Local models are not available yet.</strong> The setting exists and is
          marked unavailable. The OpenRouter adapter speaks an OpenAI-compatible wire
          format, which is groundwork for running things locally later rather than a
          capability today.
        </li>
        <li>
          <strong>Stored state is data, not orders.</strong> A file can arrive over sync
          from another machine, or be written by somebody else inside a shared brain. The
          store escapes text impersonating the operator and defangs URLs and shell pipes,
          but no sanitiser can check whether a claim is true. An instruction found in state
          is a note from a peer. Verify before acting on it.
        </li>
      </ul>
      <p class="note">
        On licensing, since I said "MIT, mostly" at the top: the app is MIT, and ten Shared
        Brain backend files are source-available under a separate licence. Personal,
        educational and research use is free always, the GitHub-backed Shared Brain is free
        for everyone including organisations, and those files convert to MIT two years
        after each release. The <a href={LINKS.curatorRepo} target="_blank" rel="noopener">
        repository</a> spells out the exact terms, and I would rather you read them there
        than take my summary for it.
      </p>
    </section>

    <section class="measure stack-4" aria-labelledby="star">
      <RuleLabel as="h2" label="If it is useful" id="star" />
      <p>
        It is free, it is open, and I maintain it in the open. A star is how these things
        get found.
      </p>
      <p>
        <a class="star" href={LINKS.curatorRepo} target="_blank" rel="noopener">
          ⭐ Star The Curator on GitHub
        </a>
      </p>
    </section>
  </div>
</Base>

<style>
  .page {
    padding-top: var(--space-7);
  }

  .head {
    margin-bottom: var(--space-7);
  }

  .head h1 {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 900;
    font-size: var(--size-2xl);
    letter-spacing: -0.015em;
    margin-top: var(--space-2);
  }

  .lede {
    font-size: var(--size-lg);
    color: var(--gold-bright);
    margin-top: var(--space-4);
    text-wrap: pretty;
  }

  .head .meta {
    margin-top: var(--space-4);
  }

  .head .meta a {
    color: var(--bone-dim);
  }

  .badge {
    margin-top: var(--space-3);
  }

  /* Width varies with the star count, which is the point of a live badge. */
  .badge img {
    height: 20px;
    width: auto;
    border-radius: var(--radius);
  }

  section {
    margin-bottom: var(--space-8);
  }

  .caveat {
    padding: var(--space-4);
    border-left: 2px solid var(--gold-dim);
    background: var(--ink-raised);
    font-size: var(--size-sm);
    color: var(--bone-dim);
  }

  .caveat strong {
    color: var(--gold-bright);
  }

  .note {
    font-size: var(--size-sm);
    color: var(--bone-dim);
  }

  .layers {
    list-style: none;
    counter-reset: layer;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-5);
  }

  .layers > li {
    border-left: 2px solid var(--gold-dim);
    padding-left: var(--space-4);
  }

  .layers .label {
    margin-bottom: var(--space-2);
  }

  .limits {
    padding-left: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }

  .limits li::marker {
    color: var(--gold-dim);
  }

  .limits strong {
    color: var(--gold-bright);
  }

  .steps {
    padding-left: var(--space-5);
    display: grid;
    gap: var(--space-3);
  }

  .steps li::marker {
    color: var(--gold-dim);
    font-family: var(--font-mono);
    font-size: var(--size-sm);
  }

  code {
    background: var(--ink-raised);
    border: var(--hairline) solid var(--ink-line);
    border-radius: var(--radius);
    padding: 0.1em 0.35em;
  }

  .out,
  .star {
    font-family: var(--font-mono);
    font-size: var(--size-sm);
    color: var(--gold);
    text-decoration: none;
    border-bottom: var(--hairline) solid var(--gold-dim);
    padding-bottom: 3px;
  }

  .out:hover,
  .star:hover {
    color: var(--gold-bright);
    border-bottom-color: var(--gold-bright);
  }

  .star {
    display: inline-block;
    font-size: var(--size-base);
  }
</style>
